/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    WGS/RNA-seq common params — shared by wgs and rnaseq
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    rnaseq reuses the WGS preprocess subworkflow, so these host-filter /
    sample-handling params are common to both.
----------------------------------------------------------------------------------------
*/

params {

    wgs_samples_keep_file = null
    wgs_rename_tsv = null
    wgs_skip_existing = true
    wgs_host_filter_any_mate = true
    wgs_host_filter_filter_with_unmapped_mate = true
    wgs_host_filter_min_mapq = 0
}
