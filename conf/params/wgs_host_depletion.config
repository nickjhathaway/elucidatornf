/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Host depletion only params — wgs_host_depletion_pf.nf
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The host genome/contig params are shared with wgs_preprocess_pf.nf and live in
    conf/params/wgs.config; the filter behaviour params live in
    conf/params/wgs_common.config.
----------------------------------------------------------------------------------------
*/

params {

    // keep the singletons that get dropped when a read's mate is filtered off,
    // written to <outdir>/discarded_singletons/ for auditing
    wgs_depletion_save_unpaired = false
}
