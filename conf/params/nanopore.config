/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nanopore clustering params — nanopore_clustering.nf only
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    (Shared nanopore_* params live in amplicon.config / variant_calling.config.)
----------------------------------------------------------------------------------------
*/

params {

    nanopore_clustering_min_len = 100
    nanopore_clustering_min_sample_read_count = 10
    nanopore_clustering_ncpus = 2
    nanopore_clustering_trim_front = 1
    nanopore_clustering_trim_back = 1
    nanopore_clustering_max_reads_use = null
    nanopore_extractor_use_inner_primers = false
    nanopore_clustering_lower_base = null //remove, upper are the options
    nanopore_extractor_primer_within_start = null //500
    nanopore_bam_sample_name_from_sm = true //for .bam input, name samples by the SM of the bam's read group rather than the file name
    nanopore_input_recursive = true //search --input_fastq_dir recursively for .fastq(.gz)/.bam files, e.g. a directory of dorado demux outputs
    nanopore_sample_name_prefix_top_dir = false //prefix sample names with the top directory under --input_fastq_dir, e.g. run1/.../barcode01.bam -> run1_barcode01
}
