/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Illumina clustering and read QC params — illumina_clustering.nf and illumina_read_qc.nf
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {

    illumina_clustering_paired_end_length = null
    illumina_clustering_error_profile = "illumina"
    illumina_clustering_min_sample_read_count = 50
    illumina_clustering_population_ncpus = 2
    illumina_clustering_trim_front = 1
    illumina_clustering_trim_back = 1
    illumina_clustering_filter_extracted_reads = false
    illumina_clustering_ref_seqs_dir = null
    illumina_clustering_read_qc = false

    // read QC, illumina_read_qc.nf and --illumina_clustering_read_qc
    illumina_read_qc_primary_genome = null
    illumina_read_qc_host_genome_fnp = null
    illumina_read_qc_target_info_dir = null // the output directory of an already run genTargetInfoFromGenomes, illumina_read_qc.nf only, otherwise it's generated
    illumina_read_qc_extra_args = ""
}
