/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Variant-calling params — shared by illumina, nanopore, and pathweaver
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Requires global.config (meta_fnp defaults to params.empty_file_fnp).
----------------------------------------------------------------------------------------
*/

params {

    do_variant_calling = false
    variant_calling_ncpus = 10
    known_amino_acid_changes_fnp = "${projectDir}/etc/EMPTY_FILE.txt"
    vc_variant_frequency_cut_off = 0.0099
    vc_variant_occurrence_cut_off = 2
    vc_no_pairwise_comps = false
    vc_primary_genome = false
    vc_correct_small_homopolymer_errors = null
    meta_fields_to_calc_pop_diffs = "" //region,country,subRegion,secondaryRegion
    vc_extra_args = ""

    meta_fnp = params.empty_file_fnp //sample meta
}
