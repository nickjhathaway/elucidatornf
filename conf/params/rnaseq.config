/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq params — rnaseq_process_pf.nf only
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    (Shared host-filter params live in wgs_common.config.)
----------------------------------------------------------------------------------------
*/

params {

    rnaseq_host1_filter_genome_fasta_fnp = null
    rnaseq_host1_filter_contigs_fnp = null
    rnaseq_host2_filter_genome_fasta_fnp = null
    rnaseq_host2_filter_contigs_fnp = null
    rnaseq_salmon_index = null
    // skip samples whose outputs (summary, quants, k-mer counts) are already in --outdir;
    // the combined tables, deconvolution and run summary still cover every sample
    rnaseq_skip_existing = true
    single_cell_seurat_r_object_fnp = null

    // Cap on concurrent salmon quant tasks (initial and filtered quants share it).
    // null = uncapped: the scheduler fits them by their declared memory. salmon 1.x
    // needed ~24 GB, beyond what was declared, which is why this used to be 1.
    salmon_max_forks = null

    // k-mer set extraction on the host-depleted reads (extractByCountingUniqKmersFromSets)
    // pass 1 removes reads of unwanted sets, e.g. pfrRNA_restOfGenomeAndMycoplasma.tsv.gz
    rnaseq_kmer_filter_table_fnp = null
    // sets of the filter table whose reads are kept, alongside the reads matching no set
    rnaseq_kmer_filter_kept_sets = 'genomeRest'
    rnaseq_kmer_filter_extra_args = ''
    // pass 2 sorts the rest by gene, e.g. multicopyGenesFullGenesOfInterestplusrRNAAndRestGenomeAndMycoplasma.tsv.gz
    rnaseq_kmer_sort_table_fnp = null
    // sets of the sort table not sorted into and not written out
    rnaseq_kmer_sort_exclude_sets = 'genomeRest,mycoplasma,pfrRNA'
    // stranded RNA-seq confounds strand with mate, so correct by k-mer frequency instead of strand
    rnaseq_kmer_sort_frequency_correction = true
    // largest k-mer depth eligible for correction; keeps real copy variation in tandem-repeat genes
    rnaseq_kmer_sort_frequency_max_candidate_depth = 3
    rnaseq_kmer_sort_extra_args = ''

    // summary/rnaseq_summary.tsv.gz
    // filter-pass sets counted as Pf reads
    rnaseq_summary_pf_sets = 'genomeRest,pfrRNA'
    // sort-pass sets given their own column (all sets stay in kmer_sort_extractionCounts.tsv.gz)
    rnaseq_summary_gene_sets = 'vars,rifins,stevors,surfins'
}
