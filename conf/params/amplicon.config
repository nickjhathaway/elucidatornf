/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Amplicon clustering params — shared by illumina and nanopore (SeekDeep)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A few of these reference/target inputs are also consumed by pathweaver
    (primers_fnp, nanopore_primers_errors_allowed) and index_genomes (genome_dir);
    because all param files are included, placement here is organizational only.
----------------------------------------------------------------------------------------
*/

params {

    // shared target / reference inputs
    primers_fnp = null
    genome_dir  = null
    gff_dir     = null
    nanopore_primers_errors_allowed = 2

    // shared amplicon clustering options
    nanopore_rename_key_fnp = null // a renmaing file, first column is the sample name e.g. barcode01 and the second column is a new sample name
    nanopore_render_clustering_report = false
    amplicon_clustering_pop_clustering_extra_args = "--removeOneSampOnlyOneOffHaps --excludeCommonlyLowFreqHaplotypes --excludeLowFreqOneOffs --rescueExcludedOneOffLowFreqHaplotypes"
    amplicon_clustering_test_number = null
    amplicon_clustering_number_of_files_to_investigate = null
}
