/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Global params — shared by every workflow
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Project-wide settings, generic I/O, boilerplate, and the resource ceilings.
    Included FIRST from nextflow.config so later param files can reference these
    (e.g. meta_fnp = params.empty_file_fnp).
----------------------------------------------------------------------------------------
*/

params {

    // project wide setting
    empty_file_fnp = "${projectDir}/etc/EMPTY_FILE.txt"

    // generic I/O (used across multiple workflows)
    input_fastq_dir = null
    outdir          = null

    // Boilerplate options
    publish_dir_mode             = 'copy'
    monochrome_logs              = false

    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    // pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    // custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Max Job Request Parameters
    //
    // Detected limits of the current host. Used to cap the ceilings below so a
    // request can never exceed this machine. (The VS Code extension may show a
    // false-positive on the `nextflow.util.*` reference; `nextflow lint` passes.)
    machine_cpus   = nextflow.util.SysHelper.getAvailCpus()
    machine_memory = nextflow.util.SysHelper.getAvailMemory()

    // Per-task resource ceilings used by `resourceLimits` to clamp each task's
    // request (not executor-wide limits). Override on the CLI (--max_task_cpus,
    // --max_task_memory, --max_task_time) or in a cluster profile. Effective
    // per-task ceiling = min(max_task_*, max_executor_*, machine_*).
    max_task_cpus   = 16
    max_task_memory = 128.GB
    max_task_time   = 72.h

    // Optional executor-wide ceilings (whole pipeline / global pool, local
    // executor). Cap how much of the machine Nextflow may use at once, e.g.
    // only 10 of 20 cpus. null = use all available; a set value is itself
    // capped to the machine. (For Slurm, throttle with executor.queueSize.)
    max_executor_cpus   = null
    max_executor_memory = null

    // Automatic retries (with scaled resources) per failing task. 0 disables.
    max_retry = 3

    // Node-local scratch space for the I/O-heavy alignment steps. When set, the
    // task runs in a per-task temp dir under this path and its outputs are
    // copied back to the work dir on completion, which keeps the samtools sort
    // spill files off a networked work dir. Nextflow removes the temp dir
    // itself. null = run in the work dir as usual.
    scratch_dir = null

    // Back-compat values consumed by workflow code and cluster profiles:
    //   max_cpus - cpus a tool may use, capped to the per-task ceiling + machine
    //   max_time - time ceiling referenced by the SGE/SLURM profiles
    max_cpus = [ params.max_task_cpus as int, params.machine_cpus as int ].min()
    max_time = params.max_task_time

    // Computed once at config parse time, reused across all report files.
    trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Schema validation default options
    validate_params            = true

    // Override the container image used by the apptainer/singularity profiles.
    // Pass a prebuilt local SIF to skip Nextflow's pull/mksquashfs build, e.g.
    //   --container_image file:///abs/path/elucidator.sif
    // Use a file:// URI or an absolute path for a local SIF, or any other URI
    // (docker://, library://). Empty => profile default (docker://...).
    container_image            = ''
}
