/*
This file includes default values for SLURM parameters.
*/

params {
    slurm_queue = 'general,high-memory'
    slurm_opts = ''
    slurm_use_scratch = false
}

process {
    executor = 'slurm'
    queue = "${params.slurm_queue}"
    // --scratch_dir wins when given; slurm_use_scratch = true is Nextflow's
    // default node-local scratch ($TMPDIR) for sites without a fixed path.
    scratch = params.scratch_dir ? params.scratch_dir as String : params.slurm_use_scratch
    time = params.max_time
    clusterOptions = "${params.slurm_opts}"
}
