/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nickjhathaway/elucidatornf Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/
// Optional executor-wide caps (whole pipeline / global pool, local executor).
// null = auto-detect the machine; a set value is itself capped to the machine
// so it can never oversubscribe the host. (For Slurm, throttle queueSize.)
executor {
    cpus   = params.max_executor_cpus == null ? null :
        [ params.max_executor_cpus as int, params.machine_cpus as int ].min()
    memory = params.max_executor_memory == null ? null :
        [ params.max_executor_memory as nextflow.util.MemoryUnit,
          params.machine_memory as nextflow.util.MemoryUnit ].min()
}

process {

    // Hard per-task ceilings = min(max_task_*, executor pool, machine), so a
    // task never asks for more than the executor or the host can give. This is
    // the native, strict-syntax replacement for the old check_max() function.
    resourceLimits = [
        cpus:   [ params.max_task_cpus as int,
                  params.machine_cpus as int,
                  (params.max_executor_cpus ?: params.machine_cpus) as int ].min(),
        memory: [ params.max_task_memory as nextflow.util.MemoryUnit,
                  params.machine_memory as nextflow.util.MemoryUnit,
                  (params.max_executor_memory ?: params.machine_memory) as nextflow.util.MemoryUnit ].min(),
        time:   params.max_task_time,
    ]

    // Resources (scale on retry; resourceLimits clamps each request)
    cpus   = { 1    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = 'retry'
    maxRetries    = params.max_retry
    maxErrors     = -1

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1 }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel:process_medium_low_memory {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 128.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    //specific programs
    // Aliased as HOST{1,2}_FILT_MAP_MINIMAP2 in the wgs/rnaseq subworkflows, so the
    // selector has to match the alias rather than the module name MAP_MINIMAP2.
    // Host-genome alignment of WGS samples runs 3-8 h, which overran the 8 h that
    // process_medium_low_memory allows; give it more threads, headroom for the
    // samtools sort buffers, and a ceiling above the observed tail.
    withName: '.*_FILT_MAP_MINIMAP2' {
        cpus    = { 8     * task.attempt }
        memory  = { 20.GB * task.attempt }
        time    = { 16.h  * task.attempt }
        scratch = params.scratch_dir ? params.scratch_dir as String : false
    }

    // The aligners and the bam filters take the host genome/index and the contig
    // lists as `path` inputs, so those files are hashed for every task. On a
    // networked work dir a mtime change alone (rsync, restore, rebuild, touch)
    // invalidates the whole stage at once even though the bytes are identical.
    // 'lenient' hashes path+size instead, so only real changes bust the cache.
    // Caveat: a change that keeps the byte count identical goes undetected --
    // not a realistic risk for .mmi / genome fasta / .fastq.gz inputs.
    withName: '.*(_FILT_MAP_BWA|_FILT_MAP_MINIMAP2|_BAM_FILTER_BY_CHROMS)|FINAL_MAP_BWA' {
        cache = 'lenient'
    }

    // Entry point of the per-sample alignment chain -- throttled so the later
    // stages always have capacity. See params.align_max_forks.
    withName: '.*HOST1_FILT_MAP_MINIMAP2' {
        maxForks = params.align_max_forks ?: null
    }

    withName: EXTRACT_REGION_ASSEMBLIES {
        memory = { 6.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
}
